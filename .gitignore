# Secrets. Never commit these -- the repository is public at submission.
# The wildcard matters: each profile has its own .env.<name> holding a
# different account's credentials, and one of those leaking is the same
# accident as the first one leaking.
.env
.env.*

# Local state: the journal is this machine's audit trail, not source code.
# Every profile's state, at any depth -- state/journal.db for the default and
# state/<profile>/journal.db for the others.
state/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
